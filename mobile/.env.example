# Copy this file to mobile/.env and fill in real values.
# Only the Supabase ANON key belongs in the app — the service role key must never be here (hard rule 3).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_STORAGE_S3_URL=https://your-project-ref.supabase.co/storage/v1/s3

# ── Local dev (`supabase start`) ─────────────────────────────────────────
# Keys: `supabase status -o env` → ANON_KEY / PUBLISHABLE_KEY.
# URL depends on where the app runs:
#   http://127.0.0.1:54321        iOS simulator
#   http://10.0.2.2:54321         Android emulator
#   http://<mac-LAN-IP>:54321     physical device (and also works on iOS sim)
#     e.g. http://192.168.1.151:54321 — use the host Metro prints
